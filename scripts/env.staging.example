# Copy once onto the EC2 app dir (NOT committed with secrets):
#   scp -i $EC2_KEY scripts/env.staging.example \
#     ec2-user@HOST:~/project-it-staging/.env
# Then edit ~/project-it-staging/.env on the server.
#
# Publish scripts preserve this file across deploys.

NEXT_PUBLIC_APP_URL=https://project-it.samirrodriguez.click

# Postgres on the EC2 host (or any reachable instance)
DATABASE_URL=postgresql://projectit:CHANGE_ME@127.0.0.1:5432/projectit

# Database backend for DAOs: pg (default) or supabase
# DATABASE_BACKEND=pg

# Optional — only when DATABASE_BACKEND=supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — AIService uses a mock when unset
OPENAI_API_KEY=

# Walkthrough transcripts (ffmpeg). Prefer a host binary that survives deploys:
#   curl -L https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz | tar -xJ
#   mkdir -p ~/bin && cp ffmpeg-*-amd64-static/ffmpeg ~/bin/ffmpeg
FFMPEG_PATH=/home/ec2-user/bin/ffmpeg

# Walkthrough videos (presigned PUT → S3). Leave unset to use local disk.
# Create with: bash scripts/s3_setup_walkthroughs.sh
S3_WALKTHROUGH_BUCKET=project-it-walkthroughs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
