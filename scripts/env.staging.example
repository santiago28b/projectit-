# Copy once onto the EC2 app dir (NOT committed with secrets):
#   scp -i $EC2_KEY scripts/env.staging.example \
#     ec2-user@HOST:~/project-it-staging/.env
# Then edit ~/project-it-staging/.env on the server.
#
# Publish scripts preserve this file across deploys.

NEXT_PUBLIC_APP_URL=https://project-it.samirrodriguez.click

# Postgres on the EC2 host (or any reachable instance)
DATABASE_URL=postgresql://projectit:CHANGE_ME@127.0.0.1:5432/projectit

# Optional — AIService uses a mock when unset
OPENAI_API_KEY=
