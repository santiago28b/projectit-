# =============================================================================
# Copy to .env.local for local Next.js.
# Staging/prod: set the same names on the host.
# Default DB access is Postgres via DATABASE_URL (pg). Optional Supabase JS mode below.
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Homebrew Postgres (peer/trust auth as your macOS user is typical):
DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/projectit

# Database backend for DAOs: pg (default) or supabase
# DATABASE_BACKEND=pg

# Optional — only when DATABASE_BACKEND=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — AIService uses a mock when unset
# Walkthrough Transcripts (speech-to-text). Without it, Communication isn't assessed.
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Optional: raises GitHub's rate limit when the Assessment reads repositories (public repos only).
# GITHUB_TOKEN=
# Optional: path to ffmpeg if not using the bundled ffmpeg-static binary.
# FFMPEG_PATH=
# Optional — live Claude for the AI Assessment + match reasons. Unset = mock (local dev only).
# With a key, a failed Assessment is marked failed (no mock Evidence) and can be retried.
ANTHROPIC_API_KEY=
# Model for match reasons (evaluateSubmission is pinned in claudeEvaluator.ts)
# ANTHROPIC_MODEL=claude-sonnet-5-5
