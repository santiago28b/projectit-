# =============================================================================
# Copy to .env.local for local Next.js. Staging/prod: set the same names on
# your host (Vercel, etc.). Always Postgres via Supabase — no Docker required.
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — AIService uses a mock when unset
OPENAI_API_KEY=

# Optional: local Docker Supabase (only if you later want an offline DB)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
